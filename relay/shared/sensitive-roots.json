{
  "_說明": "背景夥伴讀取的敏感位置清單與判定參數（#2356）。電腦版（relay/asn 的 acp_sensitive.rs）與 Linux 版（relay/machine 的 acp-sensitive*.mjs）共用這份資料：Node 直接讀，Rust 用守門測試逐項比對，兩邊不一致測試就會紅。改清單時三處一起改。",
  "homeDirs": [".gemini", ".ssh", ".asn", ".irori-relay", ".claude", ".codex", ".pi", ".aws", ".config", ".gnupg"],
  "asnDirNames": [".asn", ".irori-relay"],
  "extraHomePaths": [
    ".grok",
    ".claude.json",
    ".netrc",
    ".git-credentials",
    ".docker",
    ".kube",
    ".azure",
    ".npmrc",
    ".pgpass",
    ".my.cnf",
    ".pypirc",
    ".m2/settings.xml",
    ".bash_history",
    ".zsh_history",
    ".cursor",
    ".codeium",
    "AppData/Roaming/Microsoft/Credentials",
    "AppData/Roaming/Microsoft/Protect",
    "AppData/Roaming/Microsoft/Vault",
    "AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine",
    "AppData/Roaming/gcloud",
    "AppData/Roaming/GitHub CLI",
    "AppData/Roaming/Mozilla/Firefox",
    "AppData/Roaming/Opera Software",
    "AppData/Local/Microsoft/Credentials",
    "AppData/Local/Microsoft/Vault",
    "AppData/Local/Google/Chrome/User Data",
    "AppData/Local/Microsoft/Edge/User Data",
    "AppData/Local/BraveSoftware/Brave-Browser/User Data",
    "AppData/Local/Vivaldi/User Data",
    "AppData/Local/Opera Software",
    "AppData/Local/Mozilla/Firefox",
    "AppData/Local/tw.yooliang.asn"
  ],
  "prefixHomeFiles": [[".cargo", "credentials"], [".terraform.d", "credentials"]],
  "envRoots": ["CODEX_HOME", "PI_CODING_AGENT_DIR", "ASN_HOME", "IRORI_HOME", "ASN_CLAUDE_HOME", "ASN_GROK_HOME"],
  "localAppDataRoots": ["tw.yooliang.asn", "Google/Chrome/User Data", "Microsoft/Edge/User Data"],
  "appDataRoots": ["Microsoft/Credentials", "Microsoft/Protect"],
  "hostKeyDir": "/etc/ssh",
  "systemFiles": ["/etc/shadow", "/etc/gshadow"],
  "otherHomeParents": ["/home", "/users"],
  "sharedHomeNames": ["public", "default", "default user", "all users"],
  "maxPathLen": 4096,
  "maxJsonDepth": 4,
  "pathKeyWords": ["path", "file", "dir", "target", "uri", "url", "source", "glob", "root", "folder", "location", "cwd"],
  "skipKeys": ["command", "commandline", "command_line", "commands", "cmd", "script", "scripts", "scriptblock", "script_block"],
  "prose": { "lead": "/ \t\"'(=:", "trail": "/ \t\"'),;:", "trim": "\"'(),;", "maxHits": 50, "maxStarts": 8 },
  "agyTools": {
    "read": ["read_file", "view_file", "list_dir", "find_by_name", "grep_search", "read_resource", "list_resources"],
    "write": ["write_file", "edit_file", "delete_knowledge", "write_to_file", "replace_file_content", "multi_replace_file_content", "sed_file", "notebook_edit"],
    "execute": ["run_command", "send_command_input", "command_status", "notebook_execution", "execute_browser_javascript", "run_workflow", "swarm", "invoke_subagent", "define_subagent", "manage_subagents", "send_message", "schedule", "call_mcp_tool"],
    "network": ["generate_image", "read_url_content", "search_web", "open_browser_url", "read_browser_page", "capture_browser_console_logs", "capture_browser_screenshot", "list_browser_pages", "get_browser_dom"],
    "internal": ["finish", "wait", "wait_5_seconds", "ask_question", "ask_permission", "ask_custom_permission", "list_permissions", "manage_task", "update_steps", "manage_inbox", "search_marketplace", "list_plugin_accounts"],
    "list": ["list_dir", "list_resources"],
    "recursive": ["find_by_name", "grep_search"]
  },
  "preambleReadOk": "讀取這台電腦上的檔（登入資料、金鑰、各工具的設定等敏感檔除外）"
}
