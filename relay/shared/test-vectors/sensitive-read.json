    { "n": "系統層：公鑰放行", "p": "/etc/ssh/ssh_host_rsa_key.pub", "e": "allow" },
    { "n": "系統層：sshd 設定放行", "p": "/etc/ssh/sshd_config", "e": "allow" },
    { "n": "系統層：一般檔放行", "p": "/etc/hostname", "e": "allow" },
    { "n": "系統層：/etc 遞迴", "p": "/etc", "t": "recursive", "e": "sensitive" },
    { "n": "系統層：/etc 列舉", "p": "/etc", "t": "list", "e": "allow" },
    { "n": "系統層：/etc/ssh 遞迴", "p": "/etc/ssh", "t": "recursive", "e": "sensitive" },
    { "n": "系統層：/etc/ssh 列舉", "p": "/etc/ssh", "t": "list", "e": "allow" },
    { "n": "系統層：shadow", "p": "/etc/shadow", "e": "sensitive" },
    { "n": "系統層：gshadow", "p": "/etc/gshadow", "e": "sensitive" },
