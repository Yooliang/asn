{
  "_說明": "讀取的敏感位置判定測試向量（#2356）。電腦版（relay/asn 的 acp_sensitive/tests_shared.rs）與 Linux 版（relay/machine/test/acp-sensitive.test.mjs）逐筆讀同一份、比同一份期望。全部只用暫存資料夾裡的假家目錄與假 ASN 資料夾；捷徑只能在各自測試裡用暫存資料夾建，這份檔不放捷徑。",
  "_佔位符": "{TMP}=暫存根資料夾；{HOME}={TMP}/home；{HOME2}={TMP}/home2；{WORK}={TMP}/work；{ASN}={HOME}/.asn；{MACH}={ASN}/machine-T；{OWN}={MACH}/workers/甲；{X_URLP}=X 轉成 file: 網址 file: 後面的部分（X 是 HOME 或 WORK）；{REP:字串:次數}=字串重複；{BRACE}=左大括號（用來寫出字面的 ${HOME}，最後才換）。",
  "_欄位": "verdicts：n 名稱、p 路徑、e 期望（allow／sensitive／unresolvable）、t 工具（single／list／recursive，預設 single）、b 基準資料夾（預設 {WORK}）、homes 家目錄（預設 [{HOME}]）、env 環境變數、mk 要先建的資料夾、os 只在 posix 或 windows 跑、canonFails 解析一律失敗。exempt：同上，另加 ex={name,ownDirs,workDir,attachments}，用正式建立清單的做法。",
  "pure": {
    "winClean": [
      ["C:\\u\\.ssh.\\id", "C:/u/.ssh/id"],
      ["C:\\u\\.ssh \\id. ", "C:/u/.ssh/id"],
      ["C:\\u\\.ssh\\id:stream", "C:/u/.ssh/id"],
      ["C:\\u\\.ssh::$INDEX_ALLOCATION\\id", "C:/u/.ssh/id"],
      ["C:\\u\\a\\..\\b\\.\\c", "C:/u/a/../b/./c"],
      ["C:\\u\\...\\x", "C:/u/x"],
      ["\\\\?\\C:\\u\\x", "C:/u/x"],
      ["\\\\localhost\\C$\\u\\x", "C:/u/x"],
      ["rel/.ssh./a", "rel/.ssh/a"],
      ["/etc/ssh/x", "/etc/ssh/x"]
    ],
    "opaqueLocalNames": ["localhost", "127.0.0.1", "mypc"],
    "opaqueYes": [
      "\\\\?\\UNC\\localhost\\C$\\a", "\\\\?\\UNC\\mypc\\C$\\a", "\\\\?\\Volume{00000000-0000-0000-0000-000000000000}\\a",
      "\\\\.\\Volume{00000000-0000-0000-0000-000000000000}\\a", "\\\\.\\HarddiskVolume3\\a", "\\\\?\\GLOBALROOT\\Device\\x\\a",
      "\\\\.\\GLOBALROOT\\Device\\x\\a", "\\\\other-host\\C$\\a", "//?/UNC/localhost/C$/a"
    ],
    "opaqueNo": ["\\\\?\\C:\\a", "\\\\.\\C:\\a", "\\\\?\\C:", "\\\\localhost\\C$\\a", "\\\\MyPC\\D$\\a", "\\\\other-host\\share\\a", "C:\\a", "/etc/x", "relative/a", ""],
    "driveRelativeYes": ["C:..\\a", "C:.ssh\\id", "c:Users\\a", "C:a", "Z:*", "\\\\?\\C:a", "//?/C:a", "\\\\.\\C:a", "C:../a"],
    "driveRelativeNo": ["C:", "C:\\", "C:/", "C:\\a", "C:/a", "\\\\?\\C:\\a", "a", "", "ab:c", "https://x/y", "/etc/x", "relative\\a", "1:a"],
    "wildcardPrefix": [
      ["a/b/c", null], ["a/b/*.txt", "a/b"], ["/a/*/c", "/a"], ["/*", "/"], ["*.rs", "."], ["C:/*", "C:/"], ["C:\\a\\b?.txt", "C:/a"],
      ["a/[x]/b", "a"], ["a/{x,y}/b", "a"]
    ],
    "stripFileUrl": [
      ["file:///C:/a%20b/c", "C:/a b/c"], ["file://localhost/etc/x", "/etc/x"], ["/plain/%20", "/plain/%20"], ["file:/C:/a/b", "C:/a/b"],
      ["FILE:/C:/a", "C:/a"], ["file:///C%3A/a", "C:/a"], ["file:///c%3a/a%20b", "c:/a b"], ["file://pc-name/C$/a", "//pc-name/C$/a"],
      ["file://localhost/C:/a", "C:/a"], ["file:///etc/x", "/etc/x"], ["not-a-url", "not-a-url"], ["file://localhost/一二/x", "/一二/x"],
      ["file://%E4%B8%80/x", "//一/x"]
    ],
    "multibyteNoCrash": ["file://一二三四五六七八九十/x", "file://localhos一/x", "file:一二三", "文件:一二三", "file:", "file://", "一", "~一/x", "%一%/x", "$一/x", "file:///一:/x", "file:///%E4%B8%80%/x", "file://localhost一二三四五六七/x"],
    "extract": [
      { "n": "陣列與巢狀欄位都拿得到", "params": { "paths": ["a.txt", "/h/.ssh/id"], "opts": { "files": [{ "p": "~/.aws/credentials" }], "n": 3, "flag": true }, "query": "hello world", "x": ["C:\\Users\\a\\b", "file:///etc/x", "%USERPROFILE%\\a"] }, "e": ["a.txt", "/h/.ssh/id", "~/.aws/credentials", "C:\\Users\\a\\b", "file:///etc/x", "%USERPROFILE%\\a"] },
      { "n": "路徑欄位名底下的字串不管長相都要", "params": { "SearchDirectory": ".ssh", "Query": "x" }, "e": [".ssh"] },
      { "n": "空物件", "params": {}, "e": [] },
      { "n": "沒有字串", "params": { "a": 1, "b": [null, false] }, "e": [] },
      { "n": "多行一般文字不當路徑", "params": { "a": "x y\nz w/q" }, "e": [] },
      { "n": "實機事件形狀：路徑欄位首字大寫", "params": { "event": "step_update", "step_update": { "step_index": 2, "state": "ACTIVE", "step_type": "tool", "tool_name": "read_file", "tool_info": { "name": "read_file", "parameters": { "Path": "/h/.ssh/id" }, "output": "1 lines, 59 bytes" } } }, "e": ["/h/.ssh/id"] },
      { "n": "沒有分隔符的單純檔名靠欄位名", "params": { "Path": "id_rsa" }, "e": ["id_rsa"] },
      { "n": "內部控制步驟沒有路徑", "params": { "steps": [{ "status": "done", "title": "整理" }] }, "e": [] },
      { "n": "參數本身是 JSON 字串先解開", "params": "{\"Path\": \"/h/.ssh/id\", \"n\": 1}", "e": ["/h/.ssh/id"] },
      { "n": "不是 JSON 的字串照原樣當候選", "params": "/h/.ssh/id", "e": ["/h/.ssh/id"] },
      { "n": "巢狀 JSON 字串 1 層", "inner": { "p": "/h/.ssh/id" }, "nest": 1, "e": ["/h/.ssh/id"] },
      { "n": "巢狀 JSON 字串 2 層", "inner": { "p": "/h/.ssh/id" }, "nest": 2, "e": ["/h/.ssh/id"] },
      { "n": "巢狀 JSON 字串 3 層", "inner": { "p": "/h/.ssh/id" }, "nest": 3, "e": ["/h/.ssh/id"] },
      { "n": "巢狀 JSON 字串 4 層", "inner": { "p": "/h/.ssh/id" }, "nest": 4, "e": ["/h/.ssh/id"] },
      { "n": "巢狀超過上限：沒解開的原樣收進來", "inner": { "p": "/h/.ssh/id" }, "nest": 5, "e": { "len": 1, "notContains": ["/h/.ssh/id"], "containerLike": true } },
      { "n": "陣列形式的 JSON 字串也解", "params": { "arguments": "[\"/h/.ssh/id\"]" }, "e": ["/h/.ssh/id"] },
      { "n": "解不開的容器字串原樣收", "params": { "arguments": "{not json" }, "e": ["{not json"] },
      { "n": "容器字串缺結尾括號", "params": { "arguments": "{\"Path\": \"/h/.ssh/id\"" }, "e": ["{\"Path\": \"/h/.ssh/id\""] },
      { "n": "容器字串後面多接文字", "params": { "arguments": "{\"Path\": \"/h/.ssh/id\"} extra" }, "e": ["{\"Path\": \"/h/.ssh/id\"} extra"] },
      { "n": "容器字串單引號鍵", "params": { "arguments": "{'Path': 'id_rsa'}" }, "e": ["{'Path': 'id_rsa'}"] },
      { "n": "容器字串多重編碼", "params": { "arguments": "\"{\\\"Path\\\": \\\"/h/.ssh/id\\\"}\"" }, "e": ["\"{\\\"Path\\\": \\\"/h/.ssh/id\\\"}\""] },
      { "n": "一般的引號字串不受影響", "params": { "arguments": "\"plain text\"" }, "e": [] },
      { "n": "欄位名只是含有指令字眼的不略過", "params": { "description": "/h/.ssh/id", "transcript": "/h/.ssh/id", "subscription": "/h/.ssh/id", "commandments": "/h/.ssh/id", "commander": "/h/.ssh/id" }, "e": ["/h/.ssh/id"] },
      { "n": "整段命令與程式碼欄位略過", "params": { "command": "/h/.ssh/id", "CommandLine": "/h/.ssh/id", "command_line": "/h/.ssh/id", "commands": "/h/.ssh/id", "cmd": "/h/.ssh/id", "script": "/h/.ssh/id", "Scripts": "/h/.ssh/id", "script_block": "/h/.ssh/id" }, "e": [] },
      { "n": "名字裡有路徑字眼的不略過", "params": { "ScriptPath": "/h/.ssh/id" }, "e": ["/h/.ssh/id"] },
      { "n": "超長的路徑類欄位照收", "params": { "Path": "{REP:a/../:900}.ssh/id" }, "e": { "len": 1 } },
      { "n": "其他欄位超長且沒有空白、像路徑的整段收", "params": { "note": "/h/{REP:a/../:900}.ssh/id" }, "e": { "len": 1 } },
      { "n": "含換行的路徑類欄位整段收", "params": { "files": ["/w/a.txt\n/h/.ssh/id"] }, "e": { "len": 1 } },
      { "n": "其他欄位有空白的超長文字不收", "params": { "note": "see a/b {REP:word :1000}" }, "e": [] },
      { "n": "其他欄位多行含空白的一般文字不收", "params": { "note": "first line has spaces / and slash\nsecond one too" }, "e": [] },
      { "n": "多行：沒有空白又像路徑的那一行收", "params": { "note": "說明文字 有 空白\n/h/.ssh/id\nlast line" }, "e": ["/h/.ssh/id"] },
      { "n": "一般的長文字不收", "params": { "note": "please look at src/lib.rs and docs/a.md {REP:more words here :500}" }, "e": [] },
      { "n": "多行夾著敏感位置的那一行", "params": { "Message": "請幫我看一下\nsee src/lib.rs and docs/a.md for context\nplease read /h/AppData/Local/Google/Chrome/User Data/Default/Cookies for details\n結尾 /x y" }, "e": { "contains": ["/h/AppData/Local/Google/Chrome/User Data/Default/Cookies"], "maxLen": 3 } },
      { "n": "一般的多行長文字夾著含斜線的字不收", "params": { "Message": "see src/lib.rs and docs/a.md for context\n{REP:more words with a/b slash and .config-like text\n:200}" }, "e": [] },
      { "n": "路徑後面還接著別的字", "params": { "Message": "第一行\n~/.ssh/id extra\n結尾 line" }, "e": { "contains": ["~/.ssh/id"] } }
    ],
    "prose": [
      { "line": "note: C:\\Program Files\\x\\y word word word word word word word word word word", "e": [] },
      { "line": "my.sshkey is here / ok", "e": [] },
      { "line": "a x.ssh/y b", "e": [] },
      { "line": "please open ~/.ssh/id now", "contains": ["~/.ssh/id"] },
      { "line": "read \"/etc/shadow\", thanks", "contains": ["/etc/shadow"] },
      { "line": "please read /Jo Doe/.ssh/id now", "contains": ["/Jo Doe/.ssh/id"] }
    ]
  },
  "verdicts": [
    { "n": "一般檔：工作資料夾", "p": "{WORK}/a.txt", "e": "allow" },
    { "n": "一般檔：家目錄底下的一般資料夾", "p": "{HOME}/Desktop/a.txt", "e": "allow" },
    { "n": "一般檔：家目錄底下的資料夾", "p": "{HOME}/Documents", "e": "allow" },
    { "n": "名字只是前綴相同的不算：.geminiX", "p": "{HOME}/.geminiX/a", "e": "allow" },
    { "n": "名字只是前綴相同的不算：.ssh2", "p": "{HOME}/.ssh2/a", "e": "allow" },
    { "n": "名字只是前綴相同的不算：.claude.json.bak", "p": "{HOME}/.claude.json.bak", "e": "allow" },
    { "n": "相對路徑以工作資料夾為準", "p": "a.txt", "e": "allow" },
    { "n": "空字串", "p": "", "e": "allow" },
    { "n": "清單：.ssh 底下", "p": "{HOME}/.ssh/id", "e": "sensitive" },
    { "n": "清單：.gemini 底下", "p": "{HOME}/.gemini/oauth_creds.json", "e": "sensitive" },
    { "n": "清單：ASN 資料夾", "p": "{HOME}/.asn/k.bin", "e": "sensitive" },
    { "n": "清單：舊名的 ASN 資料夾", "p": "{HOME}/.irori-relay/k.bin", "e": "sensitive" },
    { "n": "清單：單一檔 .claude.json", "p": "{HOME}/.claude.json", "e": "sensitive" },
    { "n": "清單：應用資料夾", "p": "{HOME}/AppData/Local/tw.yooliang.asn/x", "e": "sensitive" },
    { "n": "清單：瀏覽器資料", "p": "{HOME}/AppData/Local/Google/Chrome/User Data/Default/Cookies", "e": "sensitive" },
    { "n": "清單：Firefox 設定檔", "p": "{HOME}/AppData/Roaming/Mozilla/Firefox/Profiles/x.default", "e": "sensitive" },
    { "n": "清單：.config 底下", "p": "{HOME}/.config/gh/hosts.yml", "e": "sensitive" },
    { "n": "清單：m2 設定", "p": "{HOME}/.m2/settings.xml", "e": "sensitive" },
    { "n": "清單：cargo 憑證（前綴）", "p": "{HOME}/.cargo/credentials.toml", "e": "sensitive" },
    { "n": "清單：terraform 憑證（前綴）", "p": "{HOME}/.terraform.d/credentials.tfrc.json", "e": "sensitive" },
    { "n": "不在清單：.gitconfig", "p": "{HOME}/.gitconfig", "e": "allow" },
    { "n": "不在清單：.env", "p": "{HOME}/.env", "e": "allow" },
    { "n": "不在清單：cargo 一般設定", "p": "{HOME}/.cargo/config.toml", "e": "allow" },
    { "n": "不在清單：cargo registry", "p": "{HOME}/.cargo/registry/x", "e": "allow" },
    { "n": "不在清單：m2 repository", "p": "{HOME}/.m2/repository/x", "e": "allow" },
    { "n": "不在清單：terraform plugins", "p": "{HOME}/.terraform.d/plugins/x", "e": "allow" },
    { "n": "檔名前綴的資料夾：遞迴搜尋擋", "p": "{HOME}/.cargo", "t": "recursive", "e": "sensitive" },
    { "n": "檔名前綴的資料夾：列舉放行", "p": "{HOME}/.cargo", "t": "list", "e": "allow" },
    { "n": "展開：~ 加斜線", "p": "~/.ssh/id", "e": "sensitive" },
    { "n": "展開：~ 加反斜線", "p": "~\\.ssh\\id", "e": "sensitive" },
    { "n": "展開：$HOME", "p": "$HOME/.ssh/id", "e": "sensitive" },
    { "n": "展開：${HOME}", "p": "${BRACE}HOME}/.ssh/id", "e": "sensitive" },
    { "n": "展開：%USERPROFILE% 斜線", "p": "%USERPROFILE%/.ssh/id", "e": "sensitive" },
    { "n": "展開：%USERPROFILE% 反斜線", "p": "%USERPROFILE%\\.ssh\\id", "e": "sensitive" },
    { "n": "展開：~ 單獨一個是家目錄本身，單檔放行", "p": "~", "e": "allow" },
    { "n": "展開：~ 加一般檔放行", "p": "~/Desktop/a.txt", "e": "allow" },
    { "n": "展開：~ 加單一敏感檔", "p": "~/.claude.json", "e": "sensitive" },
    { "n": "展開：磁碟機與路徑兩個變數", "p": "%HOMEDRIVE%%HOMEPATH%\\.ssh\\id", "e": "sensitive" },
    { "n": "展開：磁碟機與路徑兩個變數（斜線）", "p": "%HOMEDRIVE%%HOMEPATH%/.aws/credentials", "e": "sensitive" },
    { "n": "展開：磁碟機與路徑兩個變數（小寫）", "p": "%homedrive%%homepath%/.ssh/id", "e": "sensitive" },
    { "n": "展開：磁碟機與路徑兩個變數指到一般檔放行", "p": "%HOMEDRIVE%%HOMEPATH%\\Desktop\\a.txt", "e": "allow" },
    { "n": "展開：一般環境變數 %NAME%", "p": "%MYDIR%/credentials", "env": { "MYDIR": "{HOME}/.aws" }, "e": "sensitive" },
    { "n": "展開：一般環境變數 $NAME", "p": "$MYDIR/credentials", "env": { "MYDIR": "{HOME}/.aws" }, "e": "sensitive" },
    { "n": "展開：環境變數名稱不分大小寫", "p": "%mydir%/credentials", "env": { "MYDIR": "{HOME}/.aws" }, "e": "sensitive" },
    { "n": "展開不了的變數：字面不在家目錄底下就放行 $", "p": "$NOPE/x", "e": "allow" },
    { "n": "展開不了的變數：字面不在家目錄底下就放行 %", "p": "%NOPE%/x", "e": "allow" },
    { "n": "展開不了的變數：基準資料夾在家目錄底下才擋", "p": "$NOPE/x", "b": "{HOME}/proj", "mk": ["{HOME}/proj"], "e": "unresolvable" },
    { "n": "file 網址：家目錄底下的敏感檔", "p": "file:{HOME_URLP}/.ssh/id", "e": "sensitive" },
    { "n": "file 網址：百分號編碼", "p": "file:{HOME_URLP}/%2essh/id", "e": "sensitive" },
    { "n": "file 網址：前綴大小寫", "p": "FILE:{HOME_URLP}/.ssh/id", "e": "sensitive" },
    { "n": "file 網址：一般檔放行", "p": "file:{WORK_URLP}/a.txt", "e": "allow" },
    { "n": "相對路徑：工作資料夾就是使用者資料夾", "p": ".ssh/id", "b": "{HOME}", "e": "sensitive" },
    { "n": "相對路徑：一般工作資料夾", "p": ".ssh/id", "e": "allow" },
    { "n": "相對路徑：往上一層再進去", "p": "../home/.ssh/id", "e": "sensitive" },
    { "n": "相對路徑：不存在的中間層折疊後也比", "p": "x/../../home/.config/a", "e": "sensitive" },
    { "n": "相對段：絕對路徑含不存在的中間層", "p": "{WORK}/nowhere/../../home/.ssh/secret", "e": "sensitive" },
    { "n": "相對段：另一種折疊", "p": "{WORK}/x/../../home/.ssh/secret", "e": "sensitive" },
    { "n": "上層資料夾：家目錄 遞迴", "p": "{HOME}", "t": "recursive", "e": "sensitive" },
    { "n": "上層資料夾：家目錄 列舉", "p": "{HOME}", "t": "list", "e": "allow" },
    { "n": "上層資料夾：家目錄 單檔", "p": "{HOME}", "t": "single", "e": "allow" },
    { "n": "上層資料夾：再上一層 遞迴", "p": "{TMP}", "t": "recursive", "e": "sensitive" },
    { "n": "上層資料夾：再上一層 列舉", "p": "{TMP}", "t": "list", "e": "allow" },
    { "n": "上層資料夾：不含敏感位置的資料夾 遞迴", "p": "{HOME}/Desktop", "t": "recursive", "e": "allow" },
    { "n": "上層資料夾：工作資料夾 遞迴", "p": "{WORK}", "t": "recursive", "e": "allow" },
    { "n": "敏感資料夾本身：單檔", "p": "{HOME}/.ssh", "t": "single", "e": "sensitive" },
    { "n": "敏感資料夾本身：列舉", "p": "{HOME}/.ssh", "t": "list", "e": "sensitive" },
    { "n": "敏感資料夾本身：遞迴", "p": "{HOME}/.ssh", "t": "recursive", "e": "sensitive" },
    { "n": "敏感資料夾底下：列舉", "p": "{HOME}/.ssh/a", "t": "list", "e": "sensitive" },
    { "n": "敏感資料夾底下：遞迴", "p": "{HOME}/.ssh/a", "t": "recursive", "e": "sensitive" },
