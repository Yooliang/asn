{
  "_說明": "#2353 R3：模型代號的統一格式。Rust（agent_tools/models）與前端（ui/lib/model-id.mjs）讀同一份向量，兩邊逐字相同。第②階段 SQL 與 Edge Function 也要抄同一條。字元集用 pattern；另加分段檢查：以斜線切開後每一段不能是空字串、.、..（所以 a/../x、a//b、a/、./a 都不合法，a.b/c.d 合法）。Rust 與前端各自實作分段檢查，都要對每一筆向量答對。",
  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\[\\]-]{0,99}$",
  "valid": [
    "a",
    "gpt-6-luna",
    "gpt-5.6-terra",
    "gemini-4-argon-medium",
    "claude-opus-5-5-low",
    "opus[1m]",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6-luna",
    "MiniMax-M3.1-Flash",
    "x_1",
    "a:b",
    "a@b",
    "a+b",
    "openrouter/meta/llama-3",
    "a.b/c.d",
    "a/b.c/d",
    "0abc",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ],
  "invalid": [
    "",
    "-x",
    "--model",
    "-",
    ".x",
    "_x",
    "/x",
    "[x]",
    "a b",
    "a;rm",
    "a|b",
    "a$b",
    "a`b",
    "a\"b",
    "a\nb",
    "a\n",
    "a\r\n",
    "a/b\n",
    "../x",
    "..",
    ".",
    "./a",
    "a/./b",
    "a/..",
    "a/.",
    "a/../x",
    "a/../b",
    "a//b",
    "a/",
    "C:\\x",
    "a\\b",
    "\\x",
    "/abs",
    "a\tb",
    "中文",
    "a中",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ]
}
