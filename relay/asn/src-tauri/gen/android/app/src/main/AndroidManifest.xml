<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 對方傳來「震動」時讓手機震動 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 偽通話（#99）：用說的跟 AI 夥伴對話。麥克風只在通話中使用，第一次按「通話」才詢問；Play 版與自行安裝版都有 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 沒有麥克風的裝置也能裝（只是沒有通話鈕），不要被 Play 擋掉 -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11 以上要先宣告才看得到系統的語音辨識與語音合成服務 -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <!-- 自行安裝版才有安裝權限（建置時 ORG_GRADLE_PROJECT_asnDist=sideload）；Google Play 版這一行換成 INTERNET（已有，重複無害），不含安裝權限 -->
    <uses-permission android:name="${installPermission}" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- allowBackup=false：節點金鑰與登入存檔放在 App 私有資料夾，不讓系統備份帶到別支手機（會變成兩支手機共用同一把節點金鑰） -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.asn"
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 邀請連結（Android App Links）：https://asnmessenger.web.app/i/<碼> 直接開 ASN；網址只帶一組一次性、24 小時內有效的邀請碼，不帶權杖。
                 要通過網域驗證，官網 /.well-known/assetlinks.json 必須列出這個 App 的簽章憑證指紋（沒通過時會退回瀏覽器，官網 /i/ 頁有「打開 ASN」與複製邀請碼） -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="asnmessenger.web.app" android:pathPrefix="/i/" />
            </intent-filter>
            <!-- 瀏覽器登入完成後，用 tw.yooliang.asn://login-done 把使用者帶回 ASN（這個網址不帶任何權杖，只是叫 App 回到前景） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tw.yooliang.asn" android:host="login-done" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
