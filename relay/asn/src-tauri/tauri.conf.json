{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASN",
  "mainBinaryName": "asn",
  "version": "0.1.34",
  "identifier": "tw.irori.asn",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prep.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "list",
        "url": "list.html",
        "title": "Agent Sync Network Messenger",
        "width": 360,
        "height": 660,
        "minWidth": 280,
        "minHeight": 420,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://asnmessenger.web.app; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "resources": {
      "../../claude-mod/.claude-plugin/marketplace.json": "claude-mod/.claude-plugin/marketplace.json",
      "../../claude-mod/.claude-plugin/plugin.json": "claude-mod/.claude-plugin/plugin.json",
      "../../claude-mod/README.md": "claude-mod/README.md",
      "../../claude-mod/hooks/hooks.json": "claude-mod/hooks/hooks.json",
      "../../claude-mod/hooks/lib.ts": "claude-mod/hooks/lib.ts",
      "../../claude-mod/hooks/register.ts": "claude-mod/hooks/register.ts",
      "../../claude-mod/hooks/status.ts": "claude-mod/hooks/status.ts",
      "../../claude-mod/skills/asn/SKILL.md": "claude-mod/skills/asn/SKILL.md",
      "../CHANGELOG.md": "claude-mod/skills/asn/CHANGELOG.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["TradChinese"], "installerHooks": "installer-hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQUJFMDU0NDRGQkRCNzkKUldSNTIvdEVWT0Nybno3OW9iTXQ1aFhab2lIYmVJRkplSzBOZFhxVVVvZHVRZy9IMEFSdkdkdnAK",
      "endpoints": ["https://asnmessenger.web.app/update/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
