{
  "profiles": {
    "default": {
      "label": "一般（含 Chrome）",
      "command": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoExit", "-Command", "claude --dangerously-skip-permissions --chrome -n {name} --remote-control {name}"]
    },
    "codex": {
      "label": "Codex（ChatGPT）",
      "engine": "codex",
      "command": "%SystemRoot%\\System32\\cmd.exe",
      "args": ["/c", "codex", "-c", "check_for_update_on_startup=false", "-s", "workspace-write", "-a", "on-request", "resume", "{name}"]
    }
  },
  "cwd_allow": ["D:\\work", "D:\\work\\project-a", "D:\\work\\project-b"],
  "max_per_hour": 6
}
