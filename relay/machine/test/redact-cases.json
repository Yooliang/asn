{
  "說明": "遮蔽規則的共用表格：Rust（acp_policy.rs 的測試）與 Node（acp-policy.test.mjs）讀同一份。{M} 代表遮蔽標記。輸入都是明顯的假字串。",
  "cases": [
    { "name": "字首", "in": "sk-FAKExxxxxxxxxxxx rest", "out": "{M} rest" },
    { "name": "中間", "in": "see sk-FAKExxxxxxxxxxxx now", "out": "see {M} now" },
    { "name": "路徑中", "in": "/home/u/sk-FAKExxxxxxxxxxxx/notes.txt", "out": "/home/u/{M}/notes.txt" },
    { "name": "Windows 路徑中", "in": "path \"C:\\w\\sk-FAKExxxxxxxxxxxx\\a.txt\" end", "out": "path \"C:\\w\\{M}\\a.txt\" end" },
    { "name": "網址帳密", "in": "https://user:FAKEpass@example.com/a", "out": "https://{M}@example.com/a" },
    { "name": "查詢字串", "in": "https://example.com/a?x=1&token=FAKEvalue&y=2", "out": "https://example.com/a?x=1&token={M}&y=2" },
    { "name": "網址片段", "in": "https://example.com/a#access_token=FAKEvalue", "out": "https://example.com/a#access_token={M}" },
    { "name": "單引號內", "in": "echo 'sk-FAKExxxxxxxxxxxx'", "out": "echo '{M}'" },
    { "name": "雙引號內", "in": "echo \"AIzaFAKExxxxxxxxxxxxxxxxx\"", "out": "echo \"{M}\"" },
    { "name": "等號後", "in": "X=ghp_FAKExxxxxxxxxxxxxxxxxxxx run", "out": "X={M} run" },
    { "name": "多個併排", "in": "sk-FAKExxxxxxxxxxxx,AIzaFAKExxxxxxxxxxxxxxxxx ghp_FAKExxxxxxxxxxxxxxxxxxxx", "out": "{M},{M} {M}" },
    { "name": "其他金鑰樣式", "in": "a xoxb-FAKExxxxxxxxxx b eyJFAKExxxxxxxxxxxxxxxxx.FAKExxxxxxxx.FAKExxxxxxxx c", "out": "a {M} b {M} c" },
    { "name": "Authorization Bearer 只遮一次", "in": "Authorization: Bearer FAKEtoken123", "out": "Authorization: {M}" },
    { "name": "指令中的 Authorization", "in": "curl -H \"Authorization: Bearer FAKEtoken123\" https://x", "out": "curl -H \"Authorization: {M}\" https://x" },
    { "name": "Authorization Basic", "in": "Authorization: Basic RkFLRTpGQUtF", "out": "Authorization: {M}" },
    { "name": "單獨的 Bearer", "in": "Bearer FAKEtoken123 tail", "out": "{M} tail" },
    { "name": "key=value", "in": "password=hunter2 done", "out": "password={M} done" },
    { "name": "key 加金鑰", "in": "key AIzaFAKExxxxxxxxxxxxxxxxx ok", "out": "key {M} ok" },
    { "name": "api_key 與標頭式", "in": "api_key=FAKEv X-Api-Key: FAKEv2", "out": "api_key={M} X-Api-Key: {M}" },
    { "name": "JSON 寫法", "in": "{\"password\": \"FAKE pass\", \"n\": 1}", "out": "{\"password\": {M}, \"n\": 1}" },
    { "name": "一般字：sk-learn", "in": "sk-learn is fine", "out": "sk-learn is fine" },
    { "name": "一般字：scikit-learn", "in": "pip install scikit-learn", "out": "pip install scikit-learn" },
    { "name": "一般字：含底線的識別字", "in": "my_token_count is 3 and some_long_identifier_name", "out": "my_token_count is 3 and some_long_identifier_name" },
    { "name": "一般字：詞尾剛好是 sk-", "in": "task-FAKExxxxxxxxxxxxxxxx disk-image-backup-2024-01", "out": "task-FAKExxxxxxxxxxxxxxxx disk-image-backup-2024-01" },
    { "name": "一般字：沒有帳密的網址", "in": "ssh://git@github.com/org/repo https://example.com:8080/x@y", "out": "ssh://git@github.com/org/repo https://example.com:8080/x@y" },
    { "name": "一般字：一般路徑與空白", "in": "C:\\Users\\a\\b.txt  and\tkeys dir", "out": "C:\\Users\\a\\b.txt  and\tkeys dir" },
    { "name": "空字串", "in": "", "out": "" },
    { "name": "已遮蔽的不疊加：key=value", "in": "password={M} x", "out": "password={M} x" },
    { "name": "已遮蔽的不疊加：Authorization", "in": "Authorization: {M}", "out": "Authorization: {M}" },
    { "name": "已遮蔽的不疊加：網址", "in": "https://{M}@example.com/a", "out": "https://{M}@example.com/a" }
  ]
}
