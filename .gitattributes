*.bat text eol=crlf

# relay/machine 的程式會在 Linux（Aegis 主機）上跑：一律 LF
relay/machine/**/*.mjs text eol=lf
relay/machine/*.service text eol=lf
relay/machine/package.json text eol=lf
relay/machine/README.md text eol=lf

# relay/cloud-agent 在雲端 Linux 上跑：程式與 .sh 一律 LF
relay/cloud-agent/** text eol=lf

# 安卓專案的 gradlew 在 Linux／macOS 上直接執行：一律 LF（gradlew.bat 照 *.bat 規則用 CRLF）
relay/asn/src-tauri/gen/android/gradlew text eol=lf

# Aegis 試跑用的單元與腳本（在 Linux 主機上執行）：一律 LF
relay/asn/scripts/aegis/* text eol=lf
