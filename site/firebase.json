{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/i/**", "destination": "/i/index.html" },
      { "source": "/.well-known/assetlinks.json", "destination": "/wk/assetlinks.json" }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "skill/README.md"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" }
        ]
      },
      {
        "source": "/i/**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/link{,/**}",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src https://etccgmkrosbzpltudlgt.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/{roadmap,log}{,.html}",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src https://etccgmkrosbzpltudlgt.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "update/android.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "update/*.apk",
        "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }]
      },
      {
        "source": "update/latest.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(png|webp|jpg|svg|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "skill/**/*.md",
        "headers": [
          { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "skill/version.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "ads.json",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "ads/**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; img-src data:; script-src 'none'; frame-ancestors http://tauri.localhost tauri://localhost; base-uri 'none'; form-action 'none'" },
          { "key": "X-Frame-Options", "value": "ALLOWALL" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}
