@@ -417,10 +408,51 @@ impl LocalProcessInfo {
             }
         }
 
-        if let Some(info) = procs.iter().find(|info| info.th32ProcessID == pid) {
+        // 迭代版（不遞迴）：先以廣度優先找出整棵樹，再由最後發現的節點往回組裝。
+        fn build_proc(root: &PROCESSENTRY32W, procs: &[PROCESSENTRY32W]) -> LocalProcessInfo {
             let mut visited = HashSet::new();
-            visited.insert(pid);
-            Some(build_proc(info, &procs, &mut visited))
+            visited.insert(root.th32ProcessID);
+            // (在 procs 裡的位置, 父節點在 order 裡的位置, 深度)
+            let mut order: Vec<(Option<usize>, Option<usize>, usize)> = vec![(None, None, 0)];
+            let mut i = 0;
+            while i < order.len() {
+                let (idx, _, depth) = order[i];
+                let this_pid = match idx {
+                    Some(n) => procs[n].th32ProcessID,
+                    None => root.th32ProcessID,
+                };
+                for (n, kid) in procs.iter().enumerate() {
+                    if kid.th32ParentProcessID == this_pid
+                        && !visited.contains(&kid.th32ProcessID)
