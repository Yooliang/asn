+                        if depth >= MAX_DEPTH {
+                            log::warn!(
+                                "procinfo: process tree deeper than {} levels at pid {}; not expanding further",
+                                MAX_DEPTH,
+                                this_pid
+                            );
+                            break;
+                        }
+                        visited.insert(kid.th32ProcessID);
+                        order.push((Some(n), Some(i), depth + 1));
+                    }
+                }
+                i += 1;
+            }
+
+            let mut kids: Vec<HashMap<u32, LocalProcessInfo>> =
+                (0..order.len()).map(|_| HashMap::new()).collect();
+            for pos in (1..order.len()).rev() {
+                let (idx, parent, _) = order[pos];
+                let entry = &procs[idx.unwrap()];
+                let done = make_info(entry, std::mem::take(&mut kids[pos]));
+                kids[parent.unwrap()].insert(entry.th32ProcessID, done);
+            }
+            make_info(root, std::mem::take(&mut kids[0]))
+        }
+
+        if let Some(info) = procs.iter().find(|info| info.th32ProcessID == pid) {
+            Some(build_proc(info, &procs))
         } else {
             None
