{
  "說明": "依序比對，第一條符合的生效。platforms 是 desktop／linux／android 的子集合，空陣列＝不發版。沒有任何規則符合的檔案視為判斷不出來，三個平台都打。androidIfContent 是 regex：檔名或這一版的 diff 內容符合時，額外加上 android。",
  "rules": [
    { "glob": "relay/asn/src-tauri/gen/android/**", "platforms": ["android"], "說明": "安卓專案目錄（Kotlin、Gradle、資源），只有手機版會建" },
    { "glob": "relay/asn/src-tauri/tauri.android.conf.json", "platforms": ["android"], "說明": "手機專用的 Tauri 設定" },
    { "glob": "relay/asn/src-tauri/src/android*.rs", "platforms": ["android"], "說明": "整個模組只在安卓建置編進去（檔名帶 android）" },
    { "glob": "relay/asn/ui/**", "platforms": ["desktop", "linux", "android"], "說明": "共用畫面，三個平台都吃；手機畫面 m.html 也在這裡，不細分" },
    { "glob": "relay/asn/src-tauri/tauri.windows.conf.json", "platforms": ["desktop"], "說明": "Windows 專用設定" },
    { "glob": "relay/asn/src-tauri/tauri.nosign.conf.json", "platforms": ["desktop"], "說明": "Windows 本機免簽章建置設定" },
    { "glob": "relay/asn/src-tauri/installer-hooks.nsh", "platforms": ["desktop"], "說明": "Windows 安裝程式腳本" },
    { "glob": "relay/asn/src-tauri/tauri.conf.json", "platforms": ["desktop", "linux", "android"], "說明": "Tauri 主設定，手機版會把 android 設定疊在它上面" },
    { "glob": "relay/asn/src-tauri/capabilities/**", "platforms": ["desktop", "linux", "android"], "說明": "權限宣告，三個平台共用" },
    { "glob": "relay/asn/src-tauri/tests/**", "platforms": [], "說明": "Rust 測試不進安裝檔" },
    { "glob": "relay/asn/src-tauri/src/**/*.rs", "platforms": ["desktop", "linux"], "androidIfContent": "target_os\\s*=\\s*\"android\"|cfg\\s*\\(\\s*(not\\s*\\(\\s*)?mobile|mobile_entry_point|android", "說明": "Rust 核心：電腦與 Linux；內容碰到安卓或手機的 cfg 再加手機" },
    { "glob": "relay/asn/src-tauri/Cargo.toml", "platforms": ["desktop", "linux"], "androidIfContent": "android|mobile", "說明": "依賴宣告；改到安卓或手機段落再加手機" },
    { "glob": "relay/asn/src-tauri/Cargo.lock", "platforms": ["desktop", "linux"], "androidIfContent": "android|mobile|jni|ndk", "說明": "鎖定檔；改到安卓相關套件再加手機" },
    { "glob": "relay/asn/src-tauri/build.rs", "platforms": ["desktop", "linux"], "androidIfContent": "android|mobile", "說明": "建置腳本；碰到安卓或手機再加手機" },
    { "glob": "relay/asn/src-tauri/icons/**", "platforms": ["desktop", "linux"], "說明": "電腦圖示（手機圖示在 gen/android 底下）" },
    { "glob": "relay/asn/scripts/release*.mjs", "platforms": [], "說明": "發版腳本本身，不進安裝檔" },
    { "glob": "relay/asn/scripts/play-*.mjs", "platforms": [], "說明": "Play 上傳腳本，不進安裝檔" },
    { "glob": "relay/asn/scripts/gen-android-icons.mjs", "platforms": [], "說明": "產生圖示的工具，產物另外提交" },
    { "glob": "relay/asn/scripts/smoke*.mjs", "platforms": [], "說明": "冒煙測試工具" },
    { "glob": "relay/asn/scripts/smoke-probes/**", "platforms": [], "說明": "冒煙測試探針" },
    { "glob": "relay/asn/scripts/ui-shots*.mjs", "platforms": [], "說明": "畫面截圖工具" },
    { "glob": "relay/asn/scripts/hit-targets*.mjs", "platforms": [], "說明": "點擊範圍檢查工具" },
    { "glob": "relay/asn/scripts/run-tests.mjs", "platforms": [], "說明": "測試執行器" },
    { "glob": "relay/asn/scripts/test-audit.mjs", "platforms": [], "說明": "測試稽核工具" },
    { "glob": "relay/asn/scripts/fixed-sleeps.mjs", "platforms": [], "說明": "測試稽核工具" },
    { "glob": "relay/asn/scripts/headless-test-skip.txt", "platforms": [], "說明": "測試略過清單" },
    { "glob": "relay/asn/test/**", "platforms": [], "說明": "測試" },
    { "glob": "relay/asn/CHANGELOG.md", "platforms": [], "說明": "文件" },
    { "glob": "relay/asn/README.md", "platforms": [], "說明": "文件" },
    { "glob": "tools/**", "platforms": [], "說明": "工具" },
    { "glob": ".github/**", "platforms": [], "說明": "CI 與 repo 設定" },
    { "glob": "docs/**", "platforms": [], "說明": "文件" },
    { "glob": "tests/**", "platforms": [], "說明": "根目錄測試" },
    { "glob": "archive/**", "platforms": [], "說明": "封存，不參與建置" },
    { "glob": "*.md", "platforms": [], "說明": "根目錄文件" },
    { "glob": "LICENSE", "platforms": [], "說明": "授權文字" },
    { "glob": "relay/claude-mod/**", "platforms": ["desktop", "linux"], "說明": "Claude 外掛，打包進電腦版與 Linux 安裝檔（tauri.conf.json 的 resources）；領隊 #4501 定" },
    { "glob": "relay/pi-extension/**", "platforms": ["desktop", "linux"], "說明": "pi 擴充，打包進電腦版與 Linux 安裝檔；領隊 #4501 定" },
    { "glob": "relay/asn/package.json", "platforms": ["desktop", "linux", "android"], "說明": "前端依賴與版號，三個平台共用；領隊 #4501 定" },
    { "glob": "relay/asn/package-lock.json", "platforms": ["desktop", "linux", "android"], "說明": "前端依賴鎖定，三個平台共用；領隊 #4501 定" },
    { "glob": "relay/shared/**", "platforms": ["desktop", "linux", "android"], "說明": "共用程式；領隊 #4501 定三個都打" },
    { "glob": "site/**", "platforms": [], "說明": "官網與更新清單，打標籤之後才由 local_sign_publish 提交、另外部署；不列的話每一版都會被它拖成三個都打" },
    { "glob": "supabase/**", "platforms": [], "說明": "後台（migration、Edge Function）另外部署，不進安裝檔" }
  ]
}
